---
import Layout from "@/layouts/Layout.astro";
import Action from "@/components/Action.astro";
import changelogData from "@/data/changelog.json";
import landingData from "@/data/landing.json";

const meta = {
  ...landingData.meta,
  title: changelogData.meta.title,
  description: changelogData.meta.description,
  lang: changelogData.meta.lang,
  charset: changelogData.meta.charset,
};
---

<Layout meta={meta}>
  <header class="w-full flex justify-center h-20 border-b border-slate-200 bg-white">
    <nav class="flex flex-row items-center justify-between w-11/12 md:w-3/4" aria-label="Navegación">
      <Action as="a" href="/" title={changelogData.product} class="inline-flex items-center">
        <span class="text-xl md:text-2xl font-semibold text-primary">{changelogData.product}</span>
      </Action>
      <Action as="a" type="text" href="/" class="text-base md:text-lg">
        Volver al inicio
      </Action>
    </nav>
  </header>

  <main class="flex flex-col items-center px-4 py-16 md:py-24">
    <article class="w-full max-w-2xl">
      <header class="mb-12">
        <h1 class="text-3xl md:text-4xl font-semibold mb-3">{changelogData.title}</h1>
        <p class="text-base md:text-lg opacity-70">{changelogData.subtitle}</p>
      </header>

      <ol class="relative border-l-2 border-slate-200 ml-3 md:ml-4" role="list">
        {
          changelogData.timeline.map((entry) => (
            <li class="mb-12 last:mb-0 pl-8 md:pl-10 relative">
              <span
                class:list={[
                  "absolute -left-[9px] top-1.5 h-4 w-4 rounded-full border-2 border-white",
                  entry.type === "upcoming" ? "bg-amber-400" : "bg-primary",
                ]}
                aria-hidden="true"
              />

              {entry.type === "upcoming" ? (
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-4">
                    <h2 class="text-lg font-semibold">{entry.title}</h2>
                    <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">
                      {entry.status}
                    </span>
                  </div>
                  <ul class="flex flex-col gap-y-3" role="list">
                    {entry.changes.map((change) => (
                      <li class="text-slate-600">
                        <p class="font-medium text-slate-900">{change.title}</p>
                        <p class="text-sm mt-0.5">{change.description}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <div>
                  <div class="mb-1">
                    <span class="text-sm font-semibold text-primary">{entry.version}</span>
                    <span class="text-sm text-slate-400 mx-2">·</span>
                    <time class="text-sm text-slate-500" datetime="2026-09-01">{entry.date}</time>
                  </div>
                  <p class="text-sm text-slate-600 mb-4">{entry.summary}</p>
                  <ul class="flex flex-col gap-y-3" role="list">
                    {entry.changes.map((change) => (
                      <li class="text-slate-600">
                        <p class="font-medium text-slate-900">{change.title}</p>
                        <p class="text-sm mt-0.5">{change.description}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </article>
  </main>

  <footer class="flex flex-col items-center gap-y-2 py-8 border-t border-slate-200 text-sm opacity-70">
    <p>
      <Action as="a" type="text" href="/">{changelogData.product}</Action>
      {" · "}
      <Action as="a" type="text" href="mailto:contacto@nuvant.com">contacto@nuvant.com</Action>
    </p>
    <p>Monterrey, Nuevo León, México</p>
  </footer>
</Layout>
