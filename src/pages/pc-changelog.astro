---
import Layout from "@/layouts/Layout.astro";
import Action from "@/components/Action.astro";
import changelogData from "@/data/changelog.json";
import landingData from "@/data/landing.json";

const meta = {
  ...landingData.meta,
  title: changelogData.meta.title,
  description: changelogData.meta.description,
  lang: changelogData.meta.lang,
  charset: changelogData.meta.charset,
};

const categoryColors: Record<string, string> = {
  "Inteligencia artificial": "bg-primary/10 text-primary border-primary/20",
  Consultas: "bg-secondary/10 text-secondary border-secondary/20",
  Reportes: "bg-amber-500/10 text-amber-800 border-amber-500/20",
  Seguridad: "bg-rose-500/10 text-rose-800 border-rose-500/20",
  "Experiencia de uso": "bg-slate-500/10 text-slate-700 border-slate-500/20",
  Agenda: "bg-violet-500/10 text-violet-800 border-violet-500/20",
};
---

<Layout meta={meta}>
  <header class="w-full flex justify-center h-20 border-b border-slate-200/80 bg-white/90 backdrop-blur-sm sticky top-0 z-10">
    <nav class="flex flex-row items-center justify-between w-11/12 md:w-3/4" aria-label="Navegación">
      <Action as="a" href="/" title={changelogData.product} class="inline-flex items-center gap-2">
        <span class="text-xl md:text-2xl font-semibold text-primary tracking-tight">{changelogData.product}</span>
      </Action>
      <Action as="a" type="text" href="/" class="text-base md:text-lg">
        Volver al inicio
      </Action>
    </nav>
  </header>

  <main class="flex flex-col items-center px-4 py-16 md:py-24">
    <article class="w-full max-w-4xl">
      <header class="mb-14 md:mb-16">
        <p class="text-sm font-medium uppercase tracking-widest text-primary mb-3">Producto</p>
        <h1 class="text-3xl md:text-5xl font-semibold mb-4 tracking-tight">{changelogData.title}</h1>
        <p class="text-base md:text-xl opacity-70 text-pretty leading-relaxed max-w-2xl">
          {changelogData.subtitle}
        </p>
      </header>

      <div class="flex flex-col gap-y-20">
        {
          changelogData.releases.map((release) => (
            <section class="relative" aria-labelledby={`release-${release.version}`}>
              <div class="rounded-2xl border border-slate-200 bg-gradient-to-br from-primary/5 via-white to-secondary/5 p-6 md:p-8 mb-10">
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="inline-flex items-center rounded-lg bg-primary px-3 py-1 text-sm font-semibold text-white">
                    {release.version}
                  </span>
                  <span class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-1 text-sm font-medium text-slate-700">
                    {release.label}
                  </span>
                  <time class="text-sm text-slate-500" datetime="2026-09-01">
                    {release.date}
                  </time>
                </div>
                <h2 id={`release-${release.version}`} class="text-xl md:text-2xl font-semibold mb-3 text-pretty">
                  {release.highlight}
                </h2>
                <p class="text-base md:text-lg text-slate-600 text-pretty leading-relaxed">
                  {release.summary}
                </p>
              </div>

              <ul class="flex flex-col gap-y-4" role="list">
                {release.changes.map((change) => (
                  <li class="group rounded-xl border border-slate-200 bg-white p-5 md:p-6 transition-shadow hover:shadow-md hover:border-slate-300">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      <span
                        class:list={[
                          "inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium",
                          categoryColors[change.category] ?? "bg-slate-100 text-slate-700 border-slate-200",
                        ]}
                      >
                        {change.category}
                      </span>
                      {"badge" in change && change.badge && (
                        <span class="inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-blue-600 to-violet-600 px-3 py-1 text-xs font-semibold text-white">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5" aria-hidden="true">
                            <path d="M10 1.5a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0v-1.5A.75.75 0 0110 1.5zM5.05 3.05a.75.75 0 011.06 0l1.06 1.06a.75.75 0 01-1.06 1.06L5.05 4.11a.75.75 0 010-1.06zm9.9 0a.75.75 0 010 1.06l-1.06 1.06a.75.75 0 11-1.06-1.06l1.06-1.06a.75.75 0 011.06 0zM10 15a5 5 0 100-10 5 5 0 000 10zm-6.5-.75a.75.75 0 01-.75-.75v-1.5a.75.75 0 011.5 0v1.5a.75.75 0 01-.75.75zm13 0a.75.75 0 01-.75-.75v-1.5a.75.75 0 011.5 0v1.5a.75.75 0 01-.75.75zM4.11 14.95a.75.75 0 010-1.06l1.06-1.06a.75.75 0 111.06 1.06l-1.06 1.06a.75.75 0 01-1.06 0zM15.89 14.95a.75.75 0 010-1.06l1.06-1.06a.75.75 0 111.06 1.06l-1.06 1.06a.75.75 0 01-1.06 0zM10 18.5a.75.75 0 01.75-.75h1.5a.75.75 0 010 1.5h-1.5a.75.75 0 01-.75-.75zM6.25 17.25a.75.75 0 01.75-.75h1.5a.75.75 0 010 1.5H7a.75.75 0 01-.75-.75zm6.5 0a.75.75 0 01.75-.75h1.5a.75.75 0 010 1.5h-1.5a.75.75 0 01-.75-.75zM10 6.5a3.5 3.5 0 100 7 3.5 3.5 0 000-7z" />
                          </svg>
                          {change.badge}
                        </span>
                      )}
                    </div>
                    <h3 class="text-lg md:text-xl font-semibold mb-2 text-slate-900">{change.title}</h3>
                    <p class="text-base text-slate-600 text-pretty leading-relaxed">{change.description}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }

        <section class="relative" aria-labelledby="upcoming-release">
          <div class="flex flex-wrap items-center gap-3 mb-8">
            <h2 id="upcoming-release" class="text-2xl md:text-3xl font-semibold tracking-tight">
              {changelogData.upcoming.title}
            </h2>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500" />
              </span>
              {changelogData.upcoming.status}
            </span>
          </div>

          <ul class="flex flex-col gap-y-4" role="list">
            {changelogData.upcoming.items.map((item) => (
              <li class="rounded-xl border-2 border-dashed border-slate-300 bg-slate-50/80 p-5 md:p-6">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  <span
                    class:list={[
                      "inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium",
                      categoryColors[item.category] ?? "bg-slate-100 text-slate-700 border-slate-200",
                    ]}
                  >
                    {item.category}
                  </span>
                </div>
                <h3 class="text-lg md:text-xl font-semibold mb-2 text-slate-800">{item.title}</h3>
                <p class="text-base text-slate-600 text-pretty leading-relaxed">{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>
  </main>

  <footer class="flex flex-col items-center gap-y-2 py-8 border-t border-slate-200 text-sm opacity-70">
    <p>
      <Action as="a" type="text" href="/">{changelogData.product}</Action>
      {" · "}
      <Action as="a" type="text" href="mailto:contacto@nuvant.com">contacto@nuvant.com</Action>
    </p>
    <p>Monterrey, Nuevo León, México</p>
  </footer>
</Layout>
