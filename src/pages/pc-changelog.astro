---
import Layout from "@/layouts/Layout.astro";
import Action from "@/components/Action.astro";
import changelogData from "@/data/changelog.json";
import landingData from "@/data/landing.json";

const meta = {
  ...landingData.meta,
  title: changelogData.meta.title,
  description: changelogData.meta.description,
  lang: changelogData.meta.lang,
  charset: changelogData.meta.charset,
};

const allReleases = changelogData.families.flatMap((family) => family.releases);
const defaultReleaseId = allReleases[0]?.id;
---

<Layout meta={meta}>
  <header class="w-full flex justify-center h-20 border-b border-slate-200 bg-white">
    <nav class="flex flex-row items-center justify-between w-11/12 md:w-3/4" aria-label="Navegación">
      <Action as="a" href="/" title={changelogData.product} class="inline-flex items-center">
        <span class="text-xl md:text-2xl font-semibold text-primary">{changelogData.product}</span>
      </Action>
      <Action as="a" type="text" href="/" class="text-base md:text-lg">
        Volver al inicio
      </Action>
    </nav>
  </header>

  <main class="flex flex-col items-center px-4 py-16 md:py-24">
    <article class="w-full max-w-5xl">
      <header class="mb-10 md:mb-12">
        <h1 class="text-3xl md:text-4xl font-semibold mb-3">{changelogData.title}</h1>
        <p class="text-base md:text-lg opacity-70">{changelogData.subtitle}</p>
      </header>

      <div class="flex flex-col md:flex-row gap-8 md:gap-10">
        <nav
          class="md:w-56 shrink-0"
          aria-label="Versiones"
          data-changelog-nav
        >
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-3">
            Versiones
          </p>
          <ul class="flex flex-col gap-4" role="list">
            {
              changelogData.families.map((family) => (
                <li>
                  <p class="text-sm font-semibold text-slate-900 mb-2 px-1">
                    {family.label}
                  </p>
                  <ul class="flex flex-row md:flex-col gap-2 overflow-x-auto pb-1 md:pb-0 md:border-l md:border-slate-200 md:pl-3" role="list">
                    {family.releases.map((release) => {
                      const isDefault =
                        release.id === defaultReleaseId;
                      return (
                        <li class="shrink-0">
                          <button
                            type="button"
                            data-release-trigger={release.id}
                            aria-pressed={isDefault ? "true" : "false"}
                            class:list={[
                              "w-full text-left rounded-lg border px-3 py-2.5 transition",
                              isDefault
                                ? "border-primary bg-primary/5 text-primary"
                                : "border-slate-200 bg-white text-slate-700 hover:border-slate-300",
                            ]}
                          >
                            <span class="block text-sm font-semibold">{release.version}</span>
                            <span class="block text-xs mt-0.5 opacity-70">
                              {release.type === "upcoming"
                                ? release.status
                                : release.date}
                            </span>
                          </button>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex-1 min-w-0" data-changelog-panels>
          {
            allReleases.map((release, index) => (
              <section
                data-release-panel={release.id}
                hidden={index !== 0}
                aria-labelledby={`release-heading-${release.id}`}
              >
                <div class="mb-6 pb-5 border-b border-slate-200">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <h2
                      id={`release-heading-${release.id}`}
                      class="text-xl md:text-2xl font-semibold"
                    >
                      {release.version}
                    </h2>
                    {release.type === "upcoming" ? (
                      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">
                        {release.status}
                      </span>
                    ) : (
                      <time
                        class="text-sm text-slate-500"
                        datetime={"dateIso" in release ? release.dateIso : undefined}
                      >
                        {"date" in release ? release.date : ""}
                      </time>
                    )}
                  </div>
                  <p class="text-sm md:text-base text-slate-600 text-pretty leading-relaxed">
                    {release.summary}
                  </p>
                </div>

                <ul class="flex flex-col gap-y-5" role="list">
                  {release.changes.map((change) => (
                    <li>
                      <h3 class="text-base md:text-lg font-semibold text-slate-900 mb-1">
                        {change.title}
                      </h3>
                      <p class="text-sm md:text-base text-slate-600 text-pretty leading-relaxed">
                        {change.description}
                      </p>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </article>
  </main>

  <footer class="flex flex-col items-center gap-y-2 py-8 border-t border-slate-200 text-sm opacity-70">
    <p>
      <Action as="a" type="text" href="/">{changelogData.product}</Action>
      {" · "}
      <Action as="a" type="text" href="mailto:contacto@nuvant.mx">contacto@nuvant.mx</Action>
    </p>
    <p>Monterrey, Nuevo León, México</p>
  </footer>
</Layout>

<script is:inline define:vars={{ defaultReleaseId }}>
  const triggers = document.querySelectorAll("[data-release-trigger]");
  const panels = document.querySelectorAll("[data-release-panel]");

  function setActiveRelease(id) {
    triggers.forEach((trigger) => {
      const isActive = trigger.getAttribute("data-release-trigger") === id;
      trigger.setAttribute("aria-pressed", isActive ? "true" : "false");
      trigger.classList.toggle("border-primary", isActive);
      trigger.classList.toggle("bg-primary/5", isActive);
      trigger.classList.toggle("text-primary", isActive);
      trigger.classList.toggle("border-slate-200", !isActive);
      trigger.classList.toggle("bg-white", !isActive);
      trigger.classList.toggle("text-slate-700", !isActive);
    });

    panels.forEach((panel) => {
      panel.hidden = panel.getAttribute("data-release-panel") !== id;
    });
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("data-release-trigger");
      if (id) setActiveRelease(id);
    });
  });

  if (defaultReleaseId) setActiveRelease(defaultReleaseId);
</script>
