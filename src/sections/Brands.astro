---
import Action from "@/components/Action.astro";
import SectionTitle from "@/components/SectionTitle.astro";
import type { BrandsData } from "@/config/landing.interface";

interface Props {
  data: BrandsData;
}

const { data } = Astro.props;
---

<section
  id="expertise-section"
  class="flex flex-col justify-between gap-y-10 md:gap-y-0 md:gap-x-10 md:flex-row md:items-center mb-52 md:mb-60 w-full"
>
  <div class="w-full md:w-5/12 flex flex-col gap-y-6">
    <SectionTitle class="text-2xl text-center md:text-start md:text-5xl font-semibold">
      {data.title}
    </SectionTitle>
    <p class="text-lg text-center md:text-start md:text-xl opacity-90 text-pretty">
      {data.description}
    </p>
  </div>
  <div
    class="grid grid-cols-2 md:grid-cols-3 gap-y-10 gap-x-6 w-full md:w-7/12 justify-items-center items-start"
  >
    {
      data.brands.map((brand) => {
        const isSalesforce = brand.label === "Salesforce";
        return (
          <div class="w-full max-w-[9rem] hover:scale-105 transition">
            <Action
              as="a"
              href={brand.href}
              title={brand.label}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center gap-3 w-full"
            >
              <div class="flex h-20 w-full items-center justify-center">
                <img
                  src={brand.img}
                  alt={brand.label}
                  class:list={[
                    "object-contain",
                    isSalesforce
                      ? "h-14 w-auto max-w-[7.5rem]"
                      : "h-20 w-20",
                  ]}
                  loading="lazy"
                />
              </div>
              <span class="text-xs md:text-sm font-medium text-center text-black/80 leading-tight min-h-[2.5rem] flex items-start justify-center">
                {brand.label}
              </span>
            </Action>
          </div>
        );
      })
    }
  </div>
</section>
