---
import Action from "@/components/Action.astro";
import type { FooterData } from "@/config/landing.interface";

interface Props {
  data: FooterData;
}

const { data } = Astro.props;
---

<footer
  class="flex flex-col justify-center text-center gap-y-8 pt-12 pb-10 bg-black text-white w-full"
>
  <section class="flex justify-center items-center w-full">
    <Action as="a" href="/" title={data.logo} class="inline-flex items-center justify-center">
      <img
        src={data.logoImg}
        alt={data.logo}
        class="h-8 w-auto brightness-0 invert"
      />
    </Action>
  </section>
  <section>
    <p class="md:text-lg max-w-xl mx-auto px-4 opacity-90">
      {data.description}
    </p>
    <p class="mt-3 text-sm md:text-base opacity-70 px-4">
      {data.location}
    </p>
  </section>
  <section
    class="flex flex-row flex-wrap justify-center gap-x-4 gap-y-2 px-4 md:px-0 md:text-lg"
  >
    {
      data.links.map((link) => (
        <Action as="a" type="text" href={link.href}>
          {link.label}
        </Action>
      ))
    }
  </section>
  <section class="text-sm opacity-60 px-4">
    <p>© {new Date().getFullYear()} Nuvant. Todos los derechos reservados.</p>
  </section>
</footer>
