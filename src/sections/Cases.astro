---
import SectionTitle from "@/components/SectionTitle.astro";
import type { CasesData } from "@/config/landing.interface";

interface Props {
  data: CasesData;
}

const { data } = Astro.props;
---

<section id="cases-section" class="flex flex-col items-center mb-48 md:mb-56 pt-8 gap-y-12 w-full">
  <div class="w-full max-w-3xl mx-auto flex flex-col items-center gap-y-5 text-center">
    <SectionTitle>
      {data.title}
    </SectionTitle>
    <p class="text-lg md:text-xl opacity-90 text-pretty">
      {data.description}
    </p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 w-full text-left">
    {
      data.cases.map((item) => (
        <article class="flex flex-col gap-y-5 border-t border-black/15 pt-8">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-sm font-semibold uppercase tracking-wide text-primary">
              {item.sector}
            </span>
            <span class="text-sm opacity-70">· {item.status}</span>
          </div>
          <h3 class="text-2xl md:text-3xl font-semibold">{item.title}</h3>
          <p class="text-pretty opacity-90 md:text-lg">{item.description}</p>
          <ul class="flex flex-col gap-y-3 mt-2">
            {item.highlights.map((highlight) => (
              <li class="flex gap-x-3 text-base md:text-lg opacity-90">
                <span class="text-secondary mt-1 shrink-0" aria-hidden="true">
                  ▸
                </span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
