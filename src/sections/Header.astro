---
import Action from "@/components/Action.astro";
import type { HeaderData } from "@/config/landing.interface";

interface Props {
  data: HeaderData;
}

const { data } = Astro.props;
---

<header
  id="navbar"
  class="w-full transition duration-300 justify-center fixed h-16 md:h-20 z-50 flex"
>
  <nav aria-label="Navegación principal" class="flex flex-row items-center w-11/12 md:w-3/4">
    <div class="text-nowrap shrink-0">
      <Action as="a" href="/" class="inline-flex items-center" title={data.logo}>
        <img src={data.logoImg} alt={data.logo} class="h-7 md:h-8 w-auto" />
      </Action>
    </div>
    <ul class="hidden md:flex flex-row w-full justify-center gap-x-14">
      {
        data.links.map((item) => (
          <li class="text-lg hover:scale-110 hover:opacity-80">
            <Action as="a" href={item.href}>
              {item.label}
            </Action>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto md:ml-0 md:w-24 flex justify-end">
      <Action
        as="a"
        type="button"
        class="md:hidden bg-primary text-white text-sm px-3 py-1.5"
        href="mailto:contacto@nuvant.com"
      >
        Contactar
      </Action>
    </div>
  </nav>
</header>

<script>
  window.addEventListener("scroll", function () {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;

    if (window.scrollY >= 20) {
      navbar.classList.remove("border-b-transparent");
      navbar.classList.remove("bg-transparent");
      navbar.classList.add("border-b");
      navbar.classList.add("border-b-slate-300");
      navbar.classList.add("bg-white");
    } else {
      navbar.classList.remove("border-b");
      navbar.classList.remove("border-b-slate-300");
      navbar.classList.remove("bg-white");
      navbar.classList.add("border-b-transparent");
      navbar.classList.add("bg-transparent");
    }
  });
</script>
