---
import SectionTitle from "@/components/SectionTitle.astro";
import type { TrustData } from "@/config/landing.interface";

interface Props {
  data: TrustData;
}

const { data } = Astro.props;
---

<section id="trust-section" class="flex flex-col mb-48 md:mb-56 gap-y-12 w-full">
  <SectionTitle>
    {data.title}
  </SectionTitle>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8">
    {
      data.items.map((item) => (
        <div class="flex flex-col items-center text-center gap-y-3">
          <p class="text-5xl md:text-6xl font-semibold text-primary">{item.value}</p>
          <p class="text-base md:text-lg opacity-85 max-w-xs">{item.label}</p>
        </div>
      ))
    }
  </div>
</section>
