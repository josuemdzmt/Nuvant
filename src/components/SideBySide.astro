---
import Icon from "@/components/Icon.astro";
import IconWrapper from "@/components/IconWrapper.astro";
import { ASSET_PREFIX } from "@/config/constants";
import type { Adventaje } from "@/config/landing.interface";

interface Props {
  data: Adventaje;
  reversed: boolean;
}

const { data, reversed } = Astro.props;
const hasImage = Boolean(data.img);
---

<article
  class:list={[
    "flex justify-between gap-x-32 flex-col mb-20 md:mb-40",
    reversed ? "md:flex-row-reverse" : "md:flex-row",
  ]}
>
  {
    hasImage && (
      <div class="md:w-3/4 mb-8 md:mb-0">
        <img
          src={ASSET_PREFIX + data.img}
          alt={data.imageAlt ?? data.title}
          class="w-fit rounded-sm"
          loading="lazy"
        />
      </div>
    )
  }
  <div class:list={["flex flex-col gap-y-8", hasImage ? "md:w-5/6" : "w-full"]}>
    <h3 class="text-xl md:text-4xl font-semibold">{data.title}</h3>
    <p class="md:text-xl opacity-90 text-pretty">{data.description}</p>
    <ul class="flex flex-col gap-y-6">
      {
        data.checks.map((check) => (
          <li class="flex flex-row items-center gap-x-4 md:text-xl">
            <IconWrapper>
              <Icon icon="CheckIcon" />
            </IconWrapper>
            {check}
          </li>
        ))
      }
    </ul>
  </div>
</article>
